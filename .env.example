# ==============================================================================
# ResQ Platform Environment Configuration
# ==============================================================================

# Application Settings
PROJECT_NAME=ResQ
VERSION=1.0.0
API_V1_STR=/api/v1
ENVIRONMENT=development

# Security & JWT Tokens
# Generate a secure key in production using: openssl rand -hex 32
SECRET_KEY=resq-super-secret-development-jwt-key-2024-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Connection
# SQLite (default development):
DATABASE_URL=sqlite+aiosqlite:///./resq.db
# PostgreSQL (production option):
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/resq

# Metro Geographic Center (Default: Chennai Metro)
METRO_CENTER_LAT=13.0827
METRO_CENTER_LNG=80.2707
